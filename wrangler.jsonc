{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-collect",
  "main": "src/entry.py",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-bookmarks",
      "database_id": "your-d1-database-id-here"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
