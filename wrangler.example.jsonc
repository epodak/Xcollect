/**
 * ==============================================================================
 * Cloudflare Python Workers 配置文件模板 (wrangler.example.jsonc)
 *
 * 注意：这是可选的 Personal Cloud / D1 Profile 示例。
 * 只在 127.0.0.1 本地使用 Xcollect 的用户完全不需要此文件、Cloudflare 或 D1。
 *
 * 遵循 Agent Relay Hygiene 规范：
 * - 本文件随开源仓库提交，作为社区部署模板 (1:1 影子镜像)
 * - 首次部署前请复制为本地私有配置：cp wrangler.example.jsonc wrangler.jsonc
 * - 本地 wrangler.jsonc 已被 .gitignore 忽略，绝不会意外泄露个人域名与生产资源
 * ==============================================================================
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-collect",
  "main": "src/entry.py",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "python_workers",
    "disable_python_no_global_handlers"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Personal Cloud 的主同步触发器：每 15 分钟增量拉取一次 X Bookmarks。
  // Cloudflare Cron 使用 UTC；*/15 与时区无关。可按个人需要降低频率。
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-bookmarks",
      "database_id": "your-d1-database-id-here"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
  // 可选：如需绑定自定义域名，取消下方注释并修改为您的域名
  // "routes": [
  //   {
  //     "pattern": "your-domain.com",
  //     "custom_domain": true
  //   }
  // ]
}
