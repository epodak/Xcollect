{
  "name": "x-collect",
  "version": "1.0.0",
  "description": "Xcollect · Local-first Exploration Collector，当前从 X / Twitter 书签开始",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "sync:config": "python scripts/sync_config.py",
    "predev": "python scripts/sync_config.py && node -e \"const fs = require('fs'); if (fs.existsSync('.env')) fs.copyFileSync('.env', '.dev.vars');\"",
    "dev": "wrangler dev",
    "predeploy": "python scripts/sync_config.py && python scripts/check_cloud_schedule.py",
    "deploy": "wrangler deploy",
    "pub": "node scripts/deploy.js",
    "serve:local": "python local_server.py",
    "check": "python local_server.py --check",
    "d1:init:local": "wrangler d1 execute x-bookmarks --local --file=scripts/schema.sql",
    "d1:init:remote": "wrangler d1 execute x-bookmarks --remote --file=scripts/schema.sql",
    "d1:seed:local": "python scripts/seed_d1.py --local",
    "d1:seed:remote": "python scripts/seed_d1.py --remote",
    "preinstall": "npx only-allow pnpm",
    "check:cloud-schedule": "python scripts/check_cloud_schedule.py",
    "dev:scheduled": "wrangler dev --test-scheduled"
  },
  "devDependencies": {
    "wrangler": "^3.114.0"
  },
  "keywords": [
    "exploration",
    "local-first",
    "bookmark-manager",
    "twitter",
    "x-bookmarks",
    "cloudflare-workers",
    "python-workers",
    "cloudflare-d1",
    "knowledge-base"
  ]
}
