# ==============================================================================
# 本地敏感凭据契约模板 (.env.example) - 随代码提交入库
#
# 遵循 Agent Relay Hygiene 规范：
# - 本文件是 .env 的完全脱敏影子 (1:1 Key Parity)，键级必须与 .env 严格一一对应
# - 唯一职责：仅声明本地敏感机密与私有凭证占位符，绝不放非敏感解耦参数 (见 config.toml)
# ==============================================================================

# X (Twitter) 身份凭据示例 (Cookie中的 auth_token 与 ct0)
# 从浏览器 DevTools -> Application -> Cookies -> x.com 中获取
X_AUTH_TOKEN=your_x_auth_token_here
X_CT0=your_x_ct0_csrf_token_here

# 可选：用户自定义大模型私有 API 密钥 (端点与模型在 config.toml [ai] 中配置)
# 若留空，系统自动优雅降级：Cloudflare Workers AI 免费额度 -> 本地正则语义规则引擎
CUSTOM_AI_API_KEY=your_custom_ai_api_key_here
